{"id": 260815, "field": "name", "en": "EZ-Thro Shell", "hash": "23b541dee10ab836", "src": "db2@1.60.1.70170"}
{"id": 260815, "field": "description", "en": "Encase your explosives in EZ to Thro thorium-plated shells.", "hash": "b5bfed554551904f", "src": "db2@1.60.1.70170"}
{"id": 260816, "field": "name", "en": "EZ-Thro Thorium Grenade", "hash": "c12c35ced5e8f142", "src": "db2@1.60.1.70170"}
{"id": 260816, "field": "description", "en": "Inflicts $s1 Fire damage and stuns targets for $d in a 3 yd radius. Any damage will break the effect.\nAnyone can use grenades with EZ-Thro!", "hash": "759cf92a536b88cb", "src": "db2@1.60.1.70170"}
{"id": 260817, "field": "name", "en": "EZ-Thro Dark Bomb", "hash": "28c06a34e236ceb7", "src": "db2@1.60.1.70170"}
{"id": 260817, "field": "description", "en": "Inflicts $s1 Fire damage and stuns targets in a $a1 yd radius for $d. Any damage will break the effect.\nSo EZ, you can Thro it in the dark.", "hash": "61cf766f6cf51331", "src": "db2@1.60.1.70170"}
{"id": 260818, "field": "name", "en": "EZ-Thro Mana Bomb", "hash": "9a8fdb048db77f48", "src": "db2@1.60.1.70170"}
{"id": 260818, "field": "description", "en": "Burns $s1 mana from those in the blast radius and deals 50% of the mana drained in damage to the target. Also Silences targets in the blast for $d.", "hash": "d08b899999e4054a", "src": "db2@1.60.1.70170"}
{"id": 260819, "field": "name", "en": "EZ-Thro Field Transporter: Gadgetzan", "hash": "16607a54bea93eed", "src": "db2@1.60.1.70170"}
{"id": 260819, "field": "description", "en": "Safely transport yourself to Gadgetzan in Tanaris!    Emphasis on Safe!   Yup, nothing bad could ever happen while using this device!", "hash": "a6aec356f4ad3813", "src": "db2@1.60.1.70170"}
{"id": 260820, "field": "name", "en": "SAF-T Emergency Ripper: Everlook", "hash": "d748982e7accdc46", "src": "db2@1.60.1.70170"}
{"id": 260820, "field": "description", "en": "Rips the dimensional walls asunder and transports you to Everlook in Winterspring.   There are technical problems that sometimes occur, but that's what Goblin Engineering is all about!", "hash": "e4f8b06f33dc8dea", "src": "db2@1.60.1.70170"}
{"id": 260821, "field": "name", "en": "EZ and SAF Field Transporter: Mt. Hyjal", "hash": "0d55e08bdf030715", "src": "db2@1.60.1.70170"}
{"id": 260821, "field": "description", "en": "Rips the dimensional walls asunder and transports you to Kaylaena's Workshop on Mount Hyjal. Technical problems have a high chance to occur with this mad combination of goblin and gnomish engineering.\nNot only combining Goblin and Gnome tech, but also combining plans from the EZ-Thro and SAF-T corporations. Who knows if this will even work?", "hash": "4c55dbf713a48aa7", "src": "db2@1.60.1.70170"}
{"id": 260822, "field": "name", "en": "Ultrasafe Rechargeable Battery", "hash": "e778a8545deff705", "src": "db2@1.60.1.70170"}
{"id": 260822, "field": "description", "en": "Restores $s1 charges to a SAF-T or EZ-Thro brand device in your possession that does not involve explosions. It would be completely Unsafe with explosives.", "hash": "848cf013b5cb9f61", "src": "db2@1.60.1.70170"}
{"id": 260823, "field": "name", "en": "Dimensional Transporter - Mt. Hyjal", "hash": "3fe3553d619798e1", "src": "db2@1.60.1.70170"}
{"id": 260823, "field": "description", "en": "Rips the dimensional walls asunder and transports you to Kaylaena's Workshop on Mount Hyjal. Technical problems have a high chance to occur with this mad combination of goblin and gnomish engineering.\nA dangerous amalgamation of Goblin and Gnome engineering techniques.", "hash": "a3c2df842f06d9fe", "src": "db2@1.60.1.70170"}
{"id": 260824, "field": "name", "en": "Gnomish Poultryizer", "hash": "2193b63ceff2e18c", "src": "db2@1.60.1.70170"}
{"id": 260824, "field": "description", "en": "Turns the target into a chicken for $1270942d. Well, that is assuming the transmogrification polarity has not been reversed...", "hash": "4ecdd5b21a94da12", "src": "db2@1.60.1.70170"}
{"id": 260825, "field": "name", "en": "Ultralight Goblin Glider", "hash": "dcdf53dbc18205ca", "src": "db2@1.60.1.70170"}
{"id": 260825, "field": "description", "en": "Glide downward through the air for $1271020d while controlling your direction of travel.", "hash": "0e9703cc3cf54963", "src": "db2@1.60.1.70170"}
{"id": 260826, "field": "name", "en": "Gnomish Weather Machine NYI", "hash": "d6e260aba8523079", "src": "db2@1.60.1.70170"}
{"id": 260827, "field": "name", "en": "Stealthman 52", "hash": "1b6a33278ab1a7c6", "src": "db2@1.60.1.70170"}
{"id": 260827, "field": "description", "en": "Cloaks the user in a stealth field for up to $d. Cannot be used in combat. The field lasts for up to ${$m4/1000} sec after moving.\nUsed by real secret agents.", "hash": "fc7d7a887bb458e2", "src": "db2@1.60.1.70170"}
{"id": 260828, "field": "name", "en": "SAF-T Nitro Boosts", "hash": "2a8457a05789ce28", "src": "db2@1.60.1.70170"}
{"id": 260828, "field": "description", "en": "$@spelldesc1225987\nRocket to safety with SAF-T.", "hash": "24b3dfe7ea7a6653", "src": "db2@1.60.1.70170"}
{"id": 260829, "field": "name", "en": "EZ-Thro Magnetic Displacer", "hash": "ed811ca6ec37b4c9", "src": "db2@1.60.1.70170"}
{"id": 260829, "field": "description", "en": "$@spelldesc1226007\nEZ-Thro corporation not responsible for magnets preventing grenades from being thrown.", "hash": "7c2a433aae6014a9", "src": "db2@1.60.1.70170"}
{"id": 260830, "field": "name", "en": "SAF-T Teleport", "hash": "6176a9c3e31eebca", "src": "db2@1.60.1.70170"}
{"id": 260830, "field": "description", "en": "$@spelldesc1225960\nTeleport to SAF-T!", "hash": "df16b971aa993f88", "src": "db2@1.60.1.70170"}
{"id": 260880, "field": "name", "en": "Air Construct Core", "hash": "6e164ffade0474fe", "src": "db2@1.60.1.70170"}
{"id": 260880, "field": "description", "en": "The glowing orb seems to be looking at you, following your movements with quiet curiosity.", "hash": "0b957eb6d69a49a2", "src": "db2@1.60.1.70170"}
{"id": 260881, "field": "name", "en": "Crystallized Lightning", "hash": "a4b8ef89fdd62adb", "src": "db2@1.60.1.70170"}
{"id": 260881, "field": "description", "en": "The surface of this object is smooth to the touch and makes the hair on the back of your neck stand up when you hold it.", "hash": "a785cc8295e32f6c", "src": "db2@1.60.1.70170"}
{"id": 260883, "field": "name", "en": "Enchanted Gyrozephyr", "hash": "ad11009b220d8862", "src": "db2@1.60.1.70170"}
{"id": 260883, "field": "description", "en": "This object softly vibrates, constantly in a state of perpetual motion. If you try to hold it still, the force it exerts increases greatly in intensity.", "hash": "81e5fb2d2b9d2d45", "src": "db2@1.60.1.70170"}
