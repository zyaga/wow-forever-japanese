{"id": 112042, "field": "description", "ja": "攻撃対象を威嚇し、threat生成が上昇します。\n", "status": "rejected", "checks": [], "provenance": {"class": "human", "translator": "WoWJapanizer", "source": "ctjt@84db736", "imported": "2026-09-13", "origins": ["ctjt@84db736#2874"]}, "english": null, "reasons": ["no_english_id"], "conflicts": [], "extra": {"short": "Threat生成が上昇。"}}
