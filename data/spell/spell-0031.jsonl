{"id": 31016, "field": "description", "ja": "コンボポイントごとにダメージを与えるフィニッシュ技です。ダメージはAttack Powerによって増加します：\n $N1ポイント：$N2-$N3ダメージ\n $N4ポイント：$N5-$N6ダメージ\n $N7ポイント：$N8-$N9ダメージ\n $N10ポイント：$N11-$N12ダメージ\n $N13ポイント：$N14-$N15ダメージ", "status": "unaligned", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5", "source": "draft-tooltip-cleanup-01-sg5@2026-09-18", "imported": "2026-09-18"}, "english": {"hash": "b268c10a383f7476", "src": "db2@1.60.1.70170"}, "reasons": [], "conflicts": []}
